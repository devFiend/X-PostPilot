# -----------------------------------------------------------------------------
# PostPilot Configuration
# -----------------------------------------------------------------------------

# AI Providers (Free tiers / Local available)
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
DEFAULT_AI_PROVIDER=groq

# Telegram Bot Interface
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# X (Twitter) Official API v2 (Optional - For Paid API Mode)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Publishing & Automation Defaults
# DEFAULT_PUBLISH_METHOD: 'manual' (100% Free, Zero Ban Risk) or 'x_api' (Paid Official API)
DEFAULT_PUBLISH_METHOD=manual
# DEFAULT_PUBLISH_MODE: 'approval' (User approves each post) or 'autopilot'
DEFAULT_PUBLISH_MODE=approval

# Scheduling & Localization
TIMEZONE=Africa/Lagos
MAX_POSTS_PER_DAY=3

# Database & Storage
POSTPILOT_DB_PATH=postpilot.db
LOG_LEVEL=INFO
